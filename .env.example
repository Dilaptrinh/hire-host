# =====================================================
# Copy file này thành `.env` rồi điền giá trị thật.
#   cp .env.example .env
# Lưu ý: KHÔNG commit `.env` (đã nằm trong .gitignore).
# =====================================================

# === DATABASE ===
MYSQL_ROOT_PASSWORD=your-mysql-root-password
MYSQL_DATABASE=web_rental

# === SYSTEM DOMAIN CONFIG ===
APP_BASE_URL=https://hosting.bootnode.cloud
APP_FRONTEND_URL=https://hosting.bootnode.cloud
# Tên miền gốc cho static hosting (phải có wildcard DNS *.bootnode.cloud trỏ về tunnel/Cloudflare)
APP_BASE_DOMAIN=bootnode.cloud

# === SECURITY / JWT ===
# Bắt buộc: chuỗi ít nhất 256-bit, thay đổi trước khi deploy production
JWT_SECRET=your-256-bit-secret-key-here-must-be-at-least-256-bits-long
SUPER_ADMIN_EMAIL=superadmin@web-rental.com
SUPER_ADMIN_PASSWORD=SuperAdmin@123

# === GOOGLE OAUTH2 KEY ===
GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# === MOMO PAYMENT KEY ===
MOMO_PARTNER_CODE=your-momo-partner-code
MOMO_ACCESS_KEY=your-momo-access-key
MOMO_SECRET_KEY=your-momo-secret-key

# === PAYOS PAYMENT KEY ===
PAYOS_CLIENT_ID=your-payos-client-id
PAYOS_API_KEY=your-payos-api-key
PAYOS_CHECKSUM_KEY=your-payos-checksum-key
